# Copy this file to .env and fill in your Firebase project's web app values.
# Get them from Firebase Console -> Project settings -> Your apps -> SDK setup.
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=1:your-project-id:web:your-app-id
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Set to "true" to point the app at the local Firebase Emulator Suite
# (see README "Local emulator" section). Leave "false" for production.
VITE_USE_EMULATORS=false
