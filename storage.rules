rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    function isAuthenticated() {
      return request.auth != null;
    }

    // Roles are stored in Firestore users/{uid}.role (NOT custom claims, which
    // this app never sets). Read the live role from Firestore so authorization
    // is accurate and takes effect immediately.
    function myRole() {
      return isAuthenticated() && firestore.exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? firestore.get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : '';
    }

    function isElectionManager() {
      return myRole() == 'ROLE_ADMINISTRATOR' || myRole() == 'ROLE_CHAIRPERSON' || myRole() == 'ROLE_SECRETARY';
    }

    // Candidate photos only. Reads restricted to any authenticated user (the
    // photos are semi-public candidate headshots); uploads/deletes are
    // election-manager only. Ensures it's an image and reasonable size (< 5MB).
    match /candidate-photos/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isElectionManager()
                   // Ensure it's an image and reasonable size (e.g. < 5MB)
                   && (request.resource == null || (request.resource.size < 5 * 1024 * 1024 && request.resource.contentType.matches('image/.*')));
    }
  }
}
