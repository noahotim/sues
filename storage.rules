rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function hasRole(role) {
      return isAuthenticated() && request.auth.token.role == role;
    }
    
    function isElectionManager() {
      return hasRole('ROLE_ADMINISTRATOR') || hasRole('ROLE_CHAIRPERSON') || hasRole('ROLE_SECRETARY');
    }

    // Candidate photos only. Reads are authenticated; only election managers
    // (Administrator/Chair/Secretary) may upload/delete images.
    match /candidate-photos/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isElectionManager()
                   // Ensure it's an image and reasonable size (e.g. < 5MB)
                   && (request.resource == null || (request.resource.size < 5 * 1024 * 1024 && request.resource.contentType.matches('image/.*')));
    }
  }
}
