rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Helpers ----------
    function isSignedIn() {
      return request.auth != null;
    }
    function userEmail() {
      return isSignedIn() && ('email' in request.auth.token) ? request.auth.token.email : '';
    }
    // Role is read from the caller's users/{uid} doc (no Cloud Functions needed).
    // The exists() guard is essential: on a brand-new account the profile doc
    // doesn't exist yet, and a bare get() would error-deny every request -
    // including the ones needed to bootstrap the profile itself.
    function myRole() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : '';
    }
    function isAdminRole() {
      return myRole() == 'ROLE_CHAIRPERSON' || myRole() == 'ROLE_SECRETARY' || myRole() == 'ROLE_ASSISTANT';
    }
    function isChairperson() {
      return myRole() == 'ROLE_CHAIRPERSON';
    }
    function isElectionManager() {
      return myRole() == 'ROLE_CHAIRPERSON' || myRole() == 'ROLE_SECRETARY';
    }
    function electionStatus(electionId) {
      return get(/databases/$(database)/documents/elections/$(electionId)).data.status;
    }
    function electionOpen(electionId) {
      let e = get(/databases/$(database)/documents/elections/$(electionId)).data;
      // The app stores times as Firestore Timestamps. Null/missing = open.
      let start = 'startTime' in e ? e.startTime : null;
      let end = 'endTime' in e ? e.endTime : null;
      return e.status == 'active'
        && (start == null || request.time >= start)
        && (end == null || request.time <= end);
    }
    function rosterRowId(electionId, email) {
      return 'voter_' + electionId + '_' + email;
    }
    // The uploaded register (eligible_emails) is SYSTEM-WIDE: a registered
    // member may participate in every active election, even without an explicit
    // per-election roster row.
    function isRegisterMember() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/eligible_emails/$(userEmail()));
    }
    function isOnRosterNow(electionId) {
      return isSignedIn() &&
        (exists(/databases/$(database)/documents/voter_roster/$(rosterRowId(electionId, userEmail())))
         || isRegisterMember());
    }
    function receiptId(electionId, positionId) {
      return userEmail() + '__' + electionId + '__' + positionId;
    }

    // ---------- Users / profiles ----------
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdminRole());
      // First-time profile creation: role must mirror the signed-up user's
      // register entry (chairperson/staff seeded ahead of time), else VOTER.
      allow create: if isSignedIn() && request.auth.uid == userId
        && request.resource.data.email == userEmail()
        && request.resource.data.role ==
            (exists(/databases/$(database)/documents/eligible_emails/$(userEmail()))
              ? get(/databases/$(database)/documents/eligible_emails/$(userEmail())).data.get('role', 'VOTER')
              : 'VOTER');
      allow update: if isSignedIn() && (
        // profile name self-service
        (request.auth.uid == userId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fullName']))
        ||
        // chairperson assigns roles
        (myRole() == 'ROLE_CHAIRPERSON'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'updatedAt']))
      );
      allow delete: if false;

      match /receipts/{receiptId} {
        allow read: if isSignedIn() && (request.auth.uid == userId || isAdminRole());
        allow write: if false; // legacy; voting no longer writes here
      }
    }

    // ---------- Elections ----------
    match /elections/{electionId} {
      allow read: if isSignedIn();
      allow write: if isElectionManager();
    }

    // ---------- Positions ----------
    match /positions/{positionId} {
      allow read: if isSignedIn() &&
        (isAdminRole() ||
         electionStatus(resource.data.electionId) in ['active', 'closed', 'published']);
      allow write: if isElectionManager();
    }

    // ---------- Candidates ----------
    match /candidates/{candidateId} {
      allow read: if isSignedIn() &&
        (isAdminRole() ||
         electionStatus(resource.data.electionId) in ['active', 'closed', 'published']);
      allow write: if isElectionManager();
    }

    // ---------- Voter roster ----------
    // READ: open to all signed-in users so the results page can show turnout
    // metrics. In a university society the eligible-voter list is semi-public.
    match /voter_roster/{rosterId} {
      allow read: if isSignedIn();
      // Managers maintain the register. Voters may ONLY flip their own turnout
      // flags (cosmetic), and only after a valid vote receipt exists.
      allow update: if isElectionManager()
        || (isSignedIn()
            && resource.data.voterEmail == userEmail()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hasVoted', 'votedPositions'])
            && request.resource.data.hasVoted == true
            && request.resource.data.votedPositions.hasAll(resource.data.votedPositions)
            && request.resource.data.votedPositions.size() > resource.data.votedPositions.size());
      allow create, delete: if isElectionManager();
    }

    // ---------- Vote receipts (the once-and-only-once lock) ----------
    // Deterministic id: "<email>__<electionId>__<positionId>".
    // Create is allowed exactly once; updates/deletes are impossible, so a
    // second ballot for the same position can never be recorded - even with
    // concurrent submissions racing each other.
    match /vote_receipts/{receiptId} {
      allow read: if isSignedIn() && resource.data.voterEmail == userEmail();
      allow create: if isSignedIn()
        && request.resource.data.voterEmail == userEmail()
        && request.resource.data.nonce is string
        && request.resource.data.nonce.size() >= 20
        && request.resource.data.keys().hasOnly(['voterEmail', 'electionId', 'positionId', 'nonce', 'createdAt'])
        && electionOpen(request.resource.data.electionId)
        && isOnRosterNow(request.resource.data.electionId)
        && exists(/databases/$(database)/documents/positions/$(request.resource.data.positionId))
        && get(/databases/$(database)/documents/positions/$(request.resource.data.positionId)).data.electionId
             == request.resource.data.electionId;
      allow update, delete: if false;
    }

    // ---------- Votes (anonymous tally records) ----------
    // The vote document id MUST equal the unguessable nonce from the caller's
    // receipt. Rules verify ownership + candidate validity; because the id is
    // unique, a replayed nonce cannot create a second record.
    // READ: open to all signed-in users — the documents are anonymous (no voter
    // identity), so revealing them does not compromise ballot secrecy.
    match /votes/{voteId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly(['electionId', 'positionId', 'candidateId', 'createdAt'])
        && voteId.size() >= 20
        && electionOpen(request.resource.data.electionId)
        && exists(/databases/$(database)/documents/vote_receipts/$(receiptId(
               request.resource.data.electionId, request.resource.data.positionId)))
        && request.resource.data.candidateId is string
        && exists(/databases/$(database)/documents/candidates/$(request.resource.data.candidateId))
        && get(/databases/$(database)/documents/candidates/$(request.resource.data.candidateId)).data.electionId
             == request.resource.data.electionId
        && get(/databases/$(database)/documents/candidates/$(request.resource.data.candidateId)).data.positionId
             == request.resource.data.positionId;
      allow update, delete: if false;
    }

    // ---------- Audit logs (realtime - written by the app as events happen) ---
    match /audit_logs/{logId} {
      allow read: if isChairperson();
      // The app appends entries itself. CAST_VOTE is anonymous (ballot secrecy);
      // every other action must identify the acting user.
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly(['action', 'entityType', 'entityId', 'details', 'createdAt', 'actorEmail'])
        && request.resource.data.action in ['CAST_VOTE', 'ELECTION_CREATED', 'ELECTION_UPDATED',
             'ELECTION_DELETED', 'POSITION_CREATED', 'POSITION_UPDATED', 'POSITION_DELETED',
             'CANDIDATE_CREATED', 'CANDIDATE_UPDATED', 'CANDIDATE_DELETED',
             'ROSTER_IMPORTED', 'VOTER_ADDED', 'VOTER_REMOVED', 'USER_ROLE_UPDATED']
        && (request.resource.data.action == 'CAST_VOTE'
            || request.resource.data.actorEmail == userEmail());
      allow update, delete: if false;
    }

    // ---------- Allowed-voter register (system-wide) ----------
    // Read: each user sees their own entry; admins see all.
    // Write: election managers maintain the register (e.g. via CSV import),
    // which grants eligibility in EVERY active election.
    match /eligible_emails/{email} {
      allow read: if isSignedIn() && (isAdminRole() || request.auth.token.email == email);
      allow write: if isElectionManager();
    }
  }
}
